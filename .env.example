# Copy to .env and fill in. The real .env is git-ignored -- never commit keys.

# --- LLM Provider Selection ---
# google | openai (cloud)  |  ollama (local, no key)
LLM_PROVIDER=google

# Optional global generation temperature (default 0.0)
# LLM_TEMPERATURE=0.0

# --- Assistant role (the "purpose") ---
# The role is NOT preset -- you define it. Precedence:
#   SYSTEM_PROMPT_FILE > SYSTEM_PROMPT > built-in generic default.
# You can also change it live in the CLI with: /system <text>
# SYSTEM_PROMPT=You are an internal company wiki. Answer strictly from CONTEXT and cite the source File.
# SYSTEM_PROMPT_FILE=./system_prompt.txt

# Number of context chunks retrieved per query (default 4)
# RAG_K=4

# --- Conversation memory (durable + model-agnostic + self-compacting) ---
# Memory is stored as a natural-language summary + recent messages, so the same
# file works across providers/models. When recent messages exceed MAX, the
# oldest are folded into the summary and KEEP_RECENT are kept verbatim.
# HISTORY_FILE=chat_history.json
# MEMORY_MAX_MESSAGES=20
# MEMORY_KEEP_RECENT=8

# --- Safety limits ---
# MAX_INPUT_CHARS=8000              # per-request input cap
# MAX_GENERATED_FILE_BYTES=2097152 # max size of a single /code-saved file (2 MiB)

# --- Google Gemini (LLM_PROVIDER=google) ---
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE
# GOOGLE_MODEL_NAME=gemini-2.5-flash

# --- OpenAI (LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# OPENAI_MODEL_NAME=gpt-4o-mini

# --- Ollama / local (LLM_PROVIDER=ollama, no key needed) ---
# OLLAMA_MODEL_NAME=gemma3:1b
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
# OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings fallback (local, no key) ---
# Must match between ingest and query.
# HF_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_PERSIST_DIR=./chroma_db

# --- Ingestion ---
# DATA_DIR=./data
# Image OCR: path to the Tesseract executable if it isn't on your PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=
